rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "mr.avishkarranjane07@gmail.com" || request.auth.token.admin == true);
    }

    // Packages Collection: Anyone can read, only admin can write
    match /settings/packages {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings Collection: Users can create and read their own bookings; Admin can read and write all
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userEmail == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Reviews Collection: Public read, authenticated write
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
