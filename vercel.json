{
  "cleanUrls": true,
  "routes": [
    { "src": "/admin", "dest": "/Website/Admin/index.html" },
    { "src": "/admin/(.*)", "dest": "/Website/Admin/$1" },
    { "src": "/app-admin", "dest": "/App/Admin/index.html" },
    { "src": "/app-admin/(.*)", "dest": "/App/Admin/$1" },
    { "src": "/app", "dest": "/App/User/index.html" },
    { "src": "/app/(.*)", "dest": "/App/User/$1" },
    { "src": "/Website/(.*)", "dest": "/Website/$1" },
    { "src": "/App/(.*)", "dest": "/App/$1" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/Website/User/$1" }
  ]
}
